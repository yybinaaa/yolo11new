__pycache__/
*.py[cod]
.pytest_cache/
.venv/
artifacts/*
!artifacts/.gitkeep
runs/*
!runs/.gitkeep


# Shared local datasets, generated caches and model binaries (keep metadata/docs).
/data/raw/train/
/data/fusai/
/data/generated/
/data/splits/*/images/
/data/splits/*/annotations/
/pretrained/**/*.pt
/pretrained/*.pt
/datasets/
/versions/*/code/data/
/versions/*/code/pretrained/*.pt
/versions/*/weights/
/versions/*/inference_packages/

# Publish only the requested V005 epoch-170 checkpoint via Git LFS.
!/versions/v005_yolo11m_v4e_split/weights/
/versions/v005_yolo11m_v4e_split/weights/*
!/versions/v005_yolo11m_v4e_split/weights/epoch170.pt
